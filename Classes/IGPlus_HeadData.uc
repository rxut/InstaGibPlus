// Generated from the head vertex data of UTPureDP2C (GPL-3). Do not edit by hand.
// The middle of the head for every frame of every player animation, in pawn space (X forward, Y right,
// Z up, before the pawn's rotation). One standard track for every model: the average of the four stock
// models (the female ones as IG+ draws them), so no model is easier or harder to hit.
// Animations the data does not have share the data of a similar one (an idle, a taunt or walking).
class IGPlus_HeadData extends Object;

var name Anims[56];
var int AnimStart[56];
var int AnimFrames[56];
var vector Centers[473];

// The compiler can not read an array this big through a class reference, so others call these.
static function int NumAnims() { return ArrayCount(default.Anims); }
static function name Anim(int i) { return default.Anims[i]; }
static function int Start(int i) { return default.AnimStart[i]; }
static function int Frames(int i) { return default.AnimFrames[i]; }
static function vector Center(int i) { return default.Centers[i]; }

